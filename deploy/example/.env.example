# Example only. Generate independent secrets; never use demo credentials in production.
NODE_ENV=production
HOST=0.0.0.0
PORT=8790
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://grid_atlas:REPLACE_PASSWORD@127.0.0.1:5432/grid_atlas
PUBLIC_ORIGINS=https://YOUR_FRONTEND_DOMAIN,https://YOUR_ADMIN_DOMAIN
COOKIE_SECURE=true
SESSION_TTL_SECONDS=7200
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PHONE_PEPPER=REPLACE_WITH_INDEPENDENT_32_RANDOM_CHARACTERS
PHONE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
MAP_GEOJSON_DIR=/absolute/path/to/your/licensed/map-geojson
AUTO_MIGRATE=false
