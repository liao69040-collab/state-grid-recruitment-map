    "test:api": "npm --prefix platform/api test",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "^1.20.0",
    "countup.js": "^2.10.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.1",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "vue": "3.5.42",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.3.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.26",
    "sass": "^1.103.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.3"
