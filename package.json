{
  "name": "hengzhen-grid-atlas",
  "version": "1.0.0",
  "description": "Source-aware power-grid recruitment maps, school rankings, mobile query and administration.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "demo": "node scripts/demo-run.mjs",
    "test:demo": "node scripts/demo-test.mjs",
    "build": "vite build",
    "build:all": "npm run build && npm --prefix admin-app run build && npm --prefix platform/api run build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
